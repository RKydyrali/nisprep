# ── Danyshpan — переменные окружения (скопируйте в .env и замените CHANGE_ME) ──

# База данных (внутри docker-сети: host = postgres)
DATABASE_URL=postgresql+asyncpg://danyshpan:CHANGE_ME@postgres:5432/danyshpan
POSTGRES_USER=danyshpan
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=danyshpan

# Redis
REDIS_URL=redis://redis:6379/0

# JWT (минимум 32 символа)
JWT_SECRET=CHANGE_ME_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Окружение
ENV=prod
DEBUG=false
PSI_CUTOFF=0.0
TIMEZONE=Asia/Almaty

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DanyshpanNis_bot
WEBHOOK_SECRET=

# Админ платформы (создаётся seed-скриптом)
ADMIN_EMAIL=admin@danyshpan.xyz
ADMIN_PASSWORD=CHANGE_ME

# CORS и фронтенд
CORS_ORIGINS=["https://danyshpan.xyz"]
FRONTEND_URL=https://danyshpan.xyz

# Фронтенд (пусто = относительный /api/v1 через nginx)
NEXT_PUBLIC_API_URL=
